{
  "name": "dsh-plugin-workflow",
  "version": "0.5.1",
  "description": "Versioned visual workflows with user interactions and durable schedules for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "scripts/halo-publish.py"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check:host": "node scripts/host-check.mjs",
    "check:web": "node scripts/web-check.mjs",
    "check:acceptance": "node scripts/web-check.mjs --acceptance",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:desktop": "node scripts/desktop-check.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@dagrejs/graphlib": "2.2.4",
    "@xyflow/react": "12.10.1",
    "ajv": "8.20.0",
    "croner": "9.1.0",
    "json-logic-js": "2.0.5",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
  }
}
